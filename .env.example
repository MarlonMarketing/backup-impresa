# Copy to .env locally, or enter these in Portainer stack variables.
# Host paths must exist and be writable/readable by the container's user.
BACKUP_VERSION=0.1.2
BIND_ADDRESS=127.0.0.1
SOURCE_PATH=/srv/backup-impresa/source
TARGET_PATH=/srv/backup-impresa/target
RESTORE_PATH=/srv/backup-impresa/restores
TARGET_ID=backup-usb-v1
TARGET_NAME=USB backup
TZ=UTC
MIN_FREE_GB=10
COOKIE_SECURE=false
NOTIFICATION_LANGUAGE=en
NOTIFY_SUCCESS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESULT_WEBHOOK_URL=
RESULT_WEBHOOK_TOKEN=
