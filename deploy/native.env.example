# systemd EnvironmentFile syntax, not a shell script. Do not add "export".
HOST=127.0.0.1
PORT=9899
DATA_DIR=/var/lib/backup-impresa
TARGET_ROOT=/srv/backup-impresa/target
RESTORE_ROOT=/srv/backup-impresa/restores
TARGET_ID=backup-usb-v1
TARGET_NAME="Backup destination"
TZ=UTC
MIN_FREE_GB=10
COOKIE_SECURE=false
BACKUP_SOURCES='[{"id":"files","name":"Files","path":"/sources/files","requiredPaths":[".backup-impresa-source"]}]'
NOTIFICATION_LANGUAGE=en
NOTIFY_SUCCESS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESULT_WEBHOOK_URL=
RESULT_WEBHOOK_TOKEN=

LOCAL_CONNECTOR_ROOTS='["/sources","/srv/backup-impresa"]'
